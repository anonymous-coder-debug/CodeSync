# ==============================
# CodeSync Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.
# ==============================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas connection string)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/codesync?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/codesync

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Client URL (used for CORS + Socket.io)
CLIENT_URL=http://localhost:5173

# Code Execution Provider: "judge0" or "piston"
CODE_EXEC_PROVIDER=piston

# Judge0 (RapidAPI or self-hosted). Leave blank if using Piston.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Piston (free, no key required) - https://github.com/engineer-man/piston
PISTON_API_URL=https://emkc.org/api/v2/piston

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
